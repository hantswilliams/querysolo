---
// Copyright 2026 QuerySolo contributors
// SPDX-License-Identifier: Apache-2.0
import '../styles/palette.css'; // the one palette the site and the app share (U3)
import '../styles/exploration.css';
import '../styles/website.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/nav';
import { url } from '../lib/url';
interface Props { title: string; description: string; mono?: boolean }
const { title, description } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary">
  <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")}>
  <meta name="querysolo:repo" content={site.github}>
  <meta name="theme-color" content="#101f24">
  <slot name="head" />
</head>
<body class="story website">
  <a class="skip-link" href="#main">Skip to content</a>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />

  <script>
    // ---- Waitlist -----------------------------------------------------------
    // Every <Waitlist/> form on the site posts through submitWaitlist().
    //
    // The endpoint is the PUBLIC_WAITLIST_URL repo variable, set in
    // .github/workflows/deploy-pages.yml. Today that is a Formspree form:
    //   https://formspree.io/f/<id>      (decided 2026-09-11; see web/TASKS.md)
    // Formspree takes a multipart POST and answers JSON when Accept says so, so the
    // "stack" field ("What do you use today?") arrives as a normal field. Keep it;
    // it is the only qualifying signal the form collects.
    //
    // functions/api/waitlist.ts in this repo is for Cloudflare Pages Functions and
    // does NOT run on GitHub Pages. It stays for the day the site moves.
    //
    // IMPORTANT: with no endpoint configured this must not report success. It used
    // to log to the console and return true, so every signup between 2026-09-09 and
    // 2026-09-11 was shown "You're on the list" and thrown away. Never again: an
    // unconfigured form says so, and the build warns (see astro.config.mjs).
    type Outcome = 'ok' | 'unconfigured' | 'error';

    async function submitWaitlist(fd: FormData): Promise<Outcome> {
      const endpoint = import.meta.env.PUBLIC_WAITLIST_URL;
      if (!endpoint) return 'unconfigured';
      try {
        const r = await fetch(endpoint, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        return r.ok ? 'ok' : 'error';
      } catch {
        return 'error';
      }
    }

    const repo = document.querySelector<HTMLMetaElement>('meta[name="querysolo:repo"]')?.content
      || 'https://github.com/hantswilliams/querysolo';

    document.querySelectorAll<HTMLFormElement>('form[data-waitlist]').forEach(f => {
      f.addEventListener('submit', async e => {
        e.preventDefault();
        const fd = new FormData(f);
        if (fd.get('_gotcha')) return;                      // honeypot; Formspree drops it server-side too
        const email = String(fd.get('email') || '').trim();
        const row = f.querySelector<HTMLElement>('.row')!;
        const done = f.querySelector<HTMLElement>('.fine.done')!;
        let fine = f.querySelector<HTMLElement>('.fine:not(.done)');
        const say = (html: string, err = true) => {
          if (!fine) { fine = document.createElement('p'); fine.className = 'fine'; f.appendChild(fine); }
          fine.innerHTML = html; fine.hidden = false; fine.classList.toggle('err', err);
        };

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          say('Please enter a valid email.');
          (f.elements.namedItem('email') as HTMLInputElement).focus();
          return;
        }

        const btn = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
        const label = btn.textContent;
        btn.disabled = true; btn.textContent = 'Sending…';
        const outcome = await submitWaitlist(fd);
        btn.disabled = false; btn.textContent = label;

        if (outcome === 'ok') {
          row.hidden = true;
          if (fine) fine.hidden = true;
          done.hidden = false;
          return;
        }
        // Anything else leaves the form standing, with the email still in it, and
        // tells the truth about why nothing was sent.
        if (outcome === 'unconfigured') {
          say(`Early access isn't open for signups yet — this form has nowhere to go, so we're not going to pretend it does. QuerySolo is public and buildable today: <a href="${repo}" rel="noopener">watch the repo</a> and you'll see the beta the moment it opens.`, false);
        } else {
          say(`Something went wrong sending that. Try again, or open an issue on <a href="${repo}" rel="noopener">GitHub</a>.`);
        }
      });
    });
  </script>
</body>
</html>
