import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import NextStep from '../components/NextStep.astro';
import { url } from '../lib/url';
import LookaheadDemo from '../components/LookaheadDemo.astro';
import DataFlow from '../components/DataFlow.astro';
import AppCapture from '../components/AppCapture.astro';
import CurrentState from '../components/CurrentState.astro';
---
<Base title="Lakelet" description="Your data, near or far. Know what fits. Explore local files and data in S3 with SQL. Lakelet Lookahead estimates the work before you run it.">
  <section class="story-hero section-frame">
    <p class="eyebrow"><span class="status-dot"></span>Local lakehouse / Open source / Developer preview</p>
    <h1>Your data, <span class="hero-location">near or far.</span><br /><span>Know what fits.</span></h1>
    <div class="home-intro">
      <div class="home-copy">
        <p>Explore local files and data in S3 with familiar SQL. Lakelet’s query gauge estimates the work before you run it.</p>
        <p class="home-foundations">Built on DuckDB, Apache Iceberg, and dbt Core.</p>
      </div>
      <div><a class="button" href={url('/docs/install')}>Try Lakelet from source ↗</a><p class="small-note">macOS + Linux · No account required</p></div>
    </div>
    <a href="#data-flow" class="scroll-cue">SEE HOW IT FITS TOGETHER <span>↓</span></a>
  </section>
  <DataFlow />
  <LookaheadDemo />
  <section class="web-section section-frame"><div class="section-heading"><div><p class="eyebrow">03 / The idea</p><h2>Understand the work.<br /><span class="accent">Before you run it.</span></h2></div><p>A table’s size is only part of the story.<br />Your columns, filters, and machine matter too.</p></div><div class="feature-columns"><article><span class="index">01</span><h3>Bring what you have.</h3><p>Import local files into Iceberg tables, or attach Parquet in S3 in place. Your original tools and open formats stay part of the picture.</p><a class="text-link" href={url('/docs/tables')}>Meet your tables ↗</a></article><article><span class="index">02</span><h3>See what it will take.</h3><p>Lookahead estimates the scan, memory, and time before execution. It says when it cannot estimate a scan. You get a reason, not just a colored dot.</p><a class="text-link" href={url('/how-it-runs')}>Read the signals ↗</a></article><article><span class="index">03</span><h3>Keep a useful answer.</h3><p>Save the query as a dbt model, with checks and a version in your project. Run it again as the data changes.</p><a class="text-link" href={url('/medallion')}>Build a workflow ↗</a></article></div></section>
  <section class="web-section section-frame" id="how-it-fits"><div class="section-heading"><div><p class="eyebrow">04 / How it fits</p><h2>Beside your editor.<br /><span class="accent">Under your SQL.</span></h2></div><p>Not an IDE. Not a cloud warehouse.<br />The part in between, on your machine.</p></div><div class="feature-columns"><article><span class="index">01</span><h3>Your editor edits the SQL.</h3><p>A project is a folder of dbt models in a git repository. Write them in VS Code, Cursor or vim; Lakelet runs them, keeps the tables, and shows you what happened. Every button in the app shows the <code>lakelet</code> line it is, so you can stay in the terminal and never open the window.</p><a class="text-link" href={url('/docs/app')}>How the app and the CLI relate ↗</a></article><article><span class="index">02</span><h3>The warehouse you don’t need BigQuery for.</h3><p>Most teams’ data fits on one machine; what the big warehouses add is a bill and a permissions system. Lakelet is that warehouse for the size you actually have, in the open format, so when a table outgrows the laptop nothing moves: BigQuery, Snowflake, Trino or Spark read the same Iceberg tables from your bucket.</p><a class="text-link" href={url('/docs/remote')}>Your bucket, their engines ↗</a></article><article><span class="index">03</span><h3>The gauge says when it isn’t enough.</h3><p>Before a query runs, you know whether this machine can. When it can’t, you have three moves: wait, point an engine you already pay for at the same tables, or — planned — burst one job to a worker in your own cloud account under a cost cap, and get the answer back in the same catalog.</p><a class="text-link" href={url('/how-it-runs')}>Where the work runs ↗</a></article></div></section>
  <section class="web-section section-frame"><div class="section-heading"><div><p class="eyebrow">05 / The workspace</p><h2>A place for the question.<br /><span class="accent">And the answer.</span></h2></div><a class="text-link" href={url('/app')}>Explore the app ↗</a></div><div class="capture-narrow"><AppCapture /></div></section>
  <section class="split-section section-frame"><div><p class="eyebrow">06 / The files are yours</p><h2>A lakehouse.<br />In a folder.</h2><p>Parquet holds the data. Iceberg describes the tables, on your disk or in S3. The catalog, SQL, and versions stay in your project folder.</p><a class="text-link" href={url('/docs/recovery')}>Understand backups and moves ↗</a></div><div class="folder-map" aria-label="Example Lakelet project with a local warehouse"><div>~/my-lakehouse <span>YOUR PROJECT</span></div><ul><li><b>warehouse/</b><span>Parquet + Iceberg metadata</span></li><li><b>models/</b><span>SQL you can read and change</span></li><li><b>.lakelet/</b><span>Catalog, history, and cache</span></li><li><b>.git/</b><span>Versions of saved work</span></li><li><b>lakelet.toml</b><span>Settings you can inspect</span></li></ul><p>For a local warehouse, back up the whole folder at rest and relocate after moving it. Tables in S3 also need their bucket files backed up.</p></div></section>
  <CurrentState />
  <NextStep />
</Base>
