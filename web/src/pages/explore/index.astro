import Exploration from '../../layouts/Exploration.astro';
import { url } from '../../lib/url';
const directions = [
  { id: 'product', n: '01', name: 'A tool you can picture.', tag: 'Product first', detail: 'Warm paper, deep teal, and the real app. A clear path from a file to an answer.', focus: 'Best for: making the first visit feel approachable.', title: 'Your next answer.\nCloser than you think.' },
  { id: 'story', n: '02', name: 'A story you can change.', tag: 'Interactive data story', detail: 'Midnight blue, electric lime, and a live experiment. Let the value of the gauge reveal itself.', focus: 'Best for: explaining what makes QuerySolo different.', title: 'A big table.\nA small question.' },
  { id: 'editorial', n: '03', name: 'An idea you can inspect.', tag: 'Technical editorial', detail: 'Ink, paper, and precise diagrams. Explain the architecture and give every claim a place to go.', focus: 'Best for: earning a technical reader’s trust.', title: 'Less infrastructure.\nMore understanding.' },
  { id: 'querysolo', n: '04', name: 'A warehouse for one.', tag: 'QuerySolo, the new name', detail: 'The prompt mark, a brick wordmark and a brick portrait, on the v2 messaging.', focus: 'Best for: seeing the new name with a new look.', title: 'A warehouse\nfor one.' },
];
---
<Exploration title="Three directions">
  <main id="main" class="studio-main">
    <header class="studio-heading"><p class="eyebrow">Website exploration / 001</p><h1>One product.<br /><span>Three ways in.</span></h1><p>The same working QuerySolo. Three different ways to explain it.<br />Explore the pages, try the interactions, and see which feels right.</p></header>
    <div class="direction-grid">
      {directions.map(d => <a class={`direction-card ${d.id}-card`} href={url(`/explore/${d.id}`)}>
        <div class="direction-preview"><span class="mini-brand">≈ querysolo <small>{d.n}</small></span><strong>{d.title}</strong>
          {d.id === 'product' ? <div class="mini-window"><div>orders.csv <span>● Runs here</span></div><i></i><i></i><i></i><i></i></div> : d.id === 'story' ? <div class="mini-scan"><b>21.9 <small>GB</small></b><div>{Array.from({ length: 36 }, (_, i) => <i class={i < 2 ? 'lit' : ''}></i>)}</div><span>Same table. A different amount to read.</span></div> : d.id === 'editorial' ? <div class="mini-diagram"><span>YOUR FILES</span><b>↓</b><span>ICEBERG + DUCKDB</span><b>↓</b><span>YOUR ANSWER</span></div> : <div class="mini-diagram"><span>&gt;_ querysolo</span><b>↓</b><span>● RUNS HERE</span></div>}
        </div>
        <div class="direction-copy"><p class="eyebrow">{d.n} / {d.tag}</p><h2>{d.name}</h2><p>{d.detail}</p><span class="direction-focus">{d.focus}</span><strong class="open-concept">Explore this direction <span>↗</span></strong></div>
      </a>)}
    </div>
    <section class="studio-notes"><p class="eyebrow">What to look for</p><div><h2>Which page makes you want to try it?</h2><p>Consider the opening message, the way the information unfolds, and how naturally the visuals explain the product. The final direction can borrow elements from more than one concept.</p></div></section>
  </main>
</Exploration>
