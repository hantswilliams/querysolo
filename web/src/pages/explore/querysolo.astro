import Exploration from '../../layouts/Exploration.astro';
import Availability from '../../components/exploration/Availability.astro';
import { url } from '../../lib/url';
import { pick } from '../../data/status';

// The three doors; their state comes from status.ts, as on the home page.
const [file, bucket, slice] = pick(['tables', 's3', 'slice']);
const doors = [
  { s: file, title: 'A file.', text: 'Drop a CSV, Parquet, JSON or Excel file. It becomes an Iceberg table, with the type conversions written down.', href: '/docs/tables' },
  { s: bucket, title: 'A bucket.', text: 'Point at Parquet already in S3. Nothing is copied, and public data needs no credentials.', href: '/docs/remote' },
  { s: slice, title: 'A warehouse you do not own.', text: 'Pull a slice onto the laptop, refreshable, and let the verdict say what fits here.' },
];
const shots = [
  ['lineage.png', 'A changed table counts.', 'Every model knows whether it is fresh, edited, out of date or never built. A new snapshot marks everything that reads it stale.', 'The Lineage screen: tables feeding models, coloured by whether each is out of date.'],
  ['changes.png', 'One feed for what happened.', 'Snapshots, runs and commits in one list, newest first. Every run is recorded against its estimate.', 'The Changes screen: runs, snapshots and saved versions in one list.'],
  ['questions.png', 'A question you keep becomes a model.', 'Two checks and a version. If you have never used dbt, you just did.', 'The Questions screen: saved questions with See the answer, Refresh and History.'],
];
const prompt = (ink: string, accent: string, size: number) =>
  `<svg viewBox="0 0 64 64" width="${size}" height="${size}" aria-hidden="true"><path d="M13 19 L27 32 L13 45" fill="none" stroke="${ink}" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><rect x="32" y="39" width="20" height="7" rx="2.5" fill="${accent}"/></svg>`;
---
<Exploration title="04 / QuerySolo" theme="querysolo" active="querysolo">
  <main id="main" class="qs">
    <p class="qs-draft section-frame">Design study · QuerySolo is a working name, pending a trademark search. The live site still says Lakelet, and so does the command.</p>

    <header class="qs-nav section-frame">
      <a class="qs-brand" href={url('/explore/querysolo')}><Fragment set:html={prompt('#F0F2E8', '#D6EE83', 30)} /><span>query<b>solo</b></span></a>
      <nav aria-label="QuerySolo concept"><a href="#fits">What fits</a><a href="#changed">What changed</a><a href="#yours">Yours</a><a class="qs-button small" href={url('/docs/install')}>Try it from source</a></nav>
    </header>

    <section class="qs-hero section-frame">
      <div class="qs-copy">
        <p class="eyebrow"><span class="status-dot"></span>A warehouse for one / Open source / Developer preview</p>
        <h1>A warehouse<br /><span>for one.</span></h1>
        <p class="qs-lede">QuerySolo is an open-source warehouse for one machine, for SQL and dbt. It says whether a query fits before it runs, records what every run actually did, and keeps every table in Iceberg so any engine can read it.</p>
        <p class="qs-beats">Know what fits. Know what changed.</p>
        <div class="qs-actions"><a class="qs-button" href={url('/docs/install')}>Try it from source <span>↗</span></a><span class="small-note">macOS + Linux · no account</span></div>
      </div>
      <figure class="qs-portrait">
        <img src={url('/mosaic-brick-76.png')} width="1064" height="714" alt="A brick-mosaic portrait of the founder mid-jump, one arm raised" />
        <figcaption>The founder, in bricks · one person, one machine</figcaption>
      </figure>
    </section>

    <section class="qs-wordmark section-frame" aria-label="The brick wordmark"><canvas id="qs-brick-word" width="1200" height="200"></canvas></section>

    <section id="fits" class="qs-section section-frame">
      <div class="section-heading"><div><p class="eyebrow">01 / Know what fits</p><h2>Before you run it,<br /><span class="lime">know.</span></h2></div><p>No silent fallback: when it will not fit,<br />it says so before it starts.</p></div>
      <div class="qs-terminal" role="img" aria-label="Two measured verdicts on a public dataset">
        <div class="qs-term-bar"><i></i><i></i><i></i><span>~/my-project</span></div>
        <pre><span class="p">$</span> querysolo sql "select country, count(*) from addresses group by 1"
<span class="g">● Runs here</span>  scans 218.9 MB of 21.9 GB · about 16 s · before the first row

<span class="p">$</span> querysolo sql "select * from addresses"
<span class="r">● Needs more machine</span>  21.9 GB · about 26 min · refused until you say run
<span class="p">$</span> <span class="cur"></span></pre>
      </div>
      <div class="qs-verdicts">
        <div><b class="g">Runs here</b><p>Fits this machine. The bytes and the seconds, before the first row.</p></div>
        <div><b class="a">Runs here, slowly</b><p>Fits, and the sentence says how long.</p></div>
        <div><b class="r">Needs more machine</b><p>Refused until you say run anyway.</p></div>
        <div><b class="m">Not estimated</b><p>It cannot attribute the scan, and says so instead of guessing.</p></div>
      </div>
      <p class="qs-fine">Measured on the Overture Maps public bucket (472,797,160 rows, no AWS account), 11 Sep 2026: <a href={url('/docs/remote')}>the details</a>. BigQuery shows the bytes. This shows the minutes, and refuses. Commands are shown under the working name; today they start with <code>lakelet</code>.</p>
    </section>

    <section id="changed" class="qs-section section-frame">
      <div class="section-heading"><div><p class="eyebrow">02 / Know what changed</p><h2>After it runs,<br /><span class="lime">know what changed.</span></h2></div><p>dbt sees a changed model. Other tools see a changed file.<br />This also sees changed data.</p></div>
      <div class="qs-shots">
        {shots.map(([img, h, p, alt]) => <article><figure><img src={url(`/screenshots/${img}`)} width="1440" height="800" loading="lazy" alt={alt} /></figure><h3>{h}</h3><p>{p}</p></article>)}
      </div>
    </section>

    <section id="yours" class="qs-section section-frame qs-split">
      <div><p class="eyebrow">03 / Nothing leaves. Any engine reads.</p><h2>Your machine.<br />Your bucket.<br /><span class="lime">Your tables.</span></h2>
        <p>Parquet holds the data and Iceberg describes it, in a folder or in your bucket, so Spark, Trino, pyiceberg, BigQuery and Databricks read the tables as they are. Nothing leaves your machine except what you ask for: <code>audit network</code> measures zero outbound attempts on the whole quickstart; the exceptions are one extension download at <code>init</code> and the buckets you name.</p>
      </div>
      <div class="qs-folder" aria-label="An example project folder">
        <div>~/my-project <span>ONE FOLDER</span></div>
        <ul><li><b>warehouse/</b><span>Parquet + Iceberg metadata</span></li><li><b>models/</b><span>SQL you can read and change</span></li><li><b>.git/</b><span>every save is a version</span></li><li><b>catalog</b><span>one writer: you</span></li></ul>
      </div>
    </section>

    <section class="qs-section section-frame">
      <div class="section-heading"><div><p class="eyebrow">04 / Three doors</p><h2>Start with<br /><span class="lime">what you have.</span></h2></div><p>For one, today: one machine, one writer, one folder.<br />For a team, two laptops on one catalog: planned.</p></div>
      <div class="qs-doors">
        {doors.map(d => <article data-state={d.s.state}><p class="eyebrow">{d.s.state === 'built' ? <><span class="status-dot"></span>Available today</> : <><span class="status-dot planned"></span>Planned · not available yet</>}</p><h3>{d.title}</h3><p>{d.text}</p>{d.href && <a class="text-link" href={url(d.href)}>Read how ↗</a>}</article>)}
      </div>
    </section>

    <Availability />

    <section class="qs-closing section-frame">
      <Fragment set:html={prompt('#F0F2E8', '#D6EE83', 64)} />
      <h2>One person. One machine.<br /><span class="lime">One warehouse.</span></h2>
      <a class="qs-button" href={url('/docs/install')}>Try it from source <span>↗</span></a>
    </section>
  </main>
</Exploration>

<style is:global>
  .querysolo{--paper:#101F24;--panel:#15292E;--ink:#F0F2E8;--muted:#A5B8B9;--line:#304247;--accent:#D6EE83;font-family:var(--sans);background:var(--paper)}
  .querysolo .preview-bar{background:#0B171B;color:#C9D5D0;border-color:#304247}
  .querysolo .preview-label span{color:#A5B8B9}.querysolo .concept-tabs a:hover{background:#15292E}.querysolo .concept-tabs a[aria-current]{border-color:#D6EE83;background:#15292E}
  .querysolo .status-dot{background:#D6EE83}.querysolo .status-dot.planned{background:none}
  .qs .lime{color:#D6EE83}
  .qs-draft{font:11px/1.6 var(--mono);color:#A5B8B9;padding:14px 0;border-bottom:1px dashed #304247}
  .qs-nav{display:flex;justify-content:space-between;align-items:center;min-height:96px;gap:24px}
  .qs-brand{display:flex;align-items:center;gap:10px;font-size:28px;font-weight:800;letter-spacing:-1.2px}
  .qs-brand b{color:#D6EE83;font-weight:800}
  .qs-nav nav{display:flex;align-items:center;gap:30px;font-size:13px;color:#C9D5D0}
  .qs-button{display:inline-flex;align-items:center;gap:16px;background:#D6EE83;color:#172622;font-weight:800;font-size:14px;padding:15px 22px;border-radius:6px}
  .qs-button.small{padding:10px 14px;font-size:12px}
  .qs-hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding:40px 0 30px}
  .qs-hero h1{font-size:clamp(56px,7.4vw,108px);font-weight:800;letter-spacing:-.045em;line-height:.98;margin:26px 0 30px}
  .qs-hero h1 span{color:#D6EE83}
  .qs-lede{font-size:18px;color:#C9D5D0;max-width:560px}
  .qs-beats{font-size:21px;font-weight:700;margin:18px 0 28px}
  .qs-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .qs-portrait img{width:100%;height:auto;border-radius:14px;border:1px solid #304247;image-rendering:pixelated;background:#15292E}
  .qs-portrait figcaption{font:10px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#A5B8B9;margin-top:12px}
  .qs-wordmark{padding:34px 0 10px}.qs-wordmark canvas{width:100%;height:auto;image-rendering:pixelated}
  .qs-section{padding:90px 0 20px}
  .qs .section-heading h2{font-weight:800;letter-spacing:-.035em}
  .qs-terminal{background:#0B171B;border:1px solid #304247;border-radius:12px;overflow:hidden}
  .qs-term-bar{display:flex;align-items:center;gap:7px;padding:12px 16px;border-bottom:1px solid #304247;font:11px var(--mono);color:#A5B8B9}
  .qs-term-bar i{width:10px;height:10px;border-radius:50%;background:#304247}.qs-term-bar span{margin-left:10px}
  .qs-terminal pre{margin:0;padding:24px 26px;font:14px/1.9 var(--mono);color:#F0F2E8;white-space:pre-wrap}
  .qs-terminal .p{color:#A5B8B9}.qs-terminal .g,.qs-verdicts .g{color:#3FBE85}.qs-terminal .r,.qs-verdicts .r{color:#F0705E}.qs-verdicts .a{color:#E0AC3C}.qs-verdicts .m{color:#C9D5D0}
  .qs-terminal .cur{display:inline-block;width:.6em;height:1.05em;background:#D6EE83;vertical-align:-.15em;animation:qs-blink 1.1s steps(1) infinite}
  @keyframes qs-blink{50%{opacity:0}}@media(prefers-reduced-motion:reduce){.qs-terminal .cur{animation:none}}
  .qs-verdicts{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:30px}
  .qs-verdicts b{font-size:17px}.qs-verdicts p{font-size:13px;color:#A5B8B9;margin-top:6px}
  .qs-fine{font-size:12px;color:#A5B8B9;margin-top:26px;max-width:820px}.qs-fine a{text-decoration:underline}
  .qs-shots{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
  .qs-shots img{border-radius:8px;border:1px solid #304247;aspect-ratio:16/10;object-fit:cover;object-position:top left;width:100%}
  .qs-shots h3{font-size:21px;font-weight:700;margin:20px 0 8px}.qs-shots p{font-size:14px;color:#A5B8B9}
  .qs-split{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
  .qs-split h2{font-size:44px;font-weight:800;letter-spacing:-.035em;line-height:1.08;margin:18px 0 24px}
  .qs-split p:not(.eyebrow){color:#C9D5D0;font-size:15px}
  .qs-folder{background:#15292E;border:1px solid #304247;border-radius:12px;padding:26px 28px;font:13px var(--mono)}
  .qs-folder>div{display:flex;justify-content:space-between;color:#D6EE83;padding-bottom:18px}.qs-folder>div span{font-size:9px;color:#A5B8B9}
  .qs-folder ul{list-style:none;margin:0;padding:0}.qs-folder li{display:flex;justify-content:space-between;gap:16px;border-top:1px solid #304247;padding:16px 0;font-size:12px}
  .qs-folder li b{font-weight:400}.qs-folder li span{color:#A5B8B9;text-align:right}
  .qs-doors{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .qs-doors article{background:#15292E;border:1px solid #304247;border-radius:12px;padding:26px}
  .qs-doors article[data-state=planned]{background:none;border-style:dashed}
  .qs-doors h3{font-size:22px;font-weight:700;margin:16px 0 10px}.qs-doors p:not(.eyebrow){font-size:14px;color:#A5B8B9;margin-bottom:16px}
  .querysolo .availability{margin-top:80px}
  .qs-closing{text-align:center;padding:100px 0 110px;display:flex;flex-direction:column;align-items:center;gap:26px}
  .qs-closing h2{font-size:52px;font-weight:800;letter-spacing:-.04em;line-height:1.08}
  @media(max-width:900px){.qs-hero,.qs-split{grid-template-columns:1fr}.qs-verdicts{grid-template-columns:1fr 1fr}.qs-shots,.qs-doors{grid-template-columns:1fr}.qs-nav nav a:not(.qs-button){display:none}.qs-closing h2{font-size:38px}.qs-split h2{font-size:36px}}
  @media(max-width:520px){.qs-verdicts{grid-template-columns:1fr}.qs-terminal pre{font-size:11px;padding:18px}.qs-lede{font-size:16px}.qs-brand{font-size:22px}}
</style>

<script>
  // Bricks: draw at low resolution, then build it stud by stud with light from the top left.
  function brickify(canvas: HTMLCanvasElement, cols: number, rows: number, draw: (g: CanvasRenderingContext2D) => void, bg: number[] | null, cell: number) {
    const low = document.createElement('canvas'); low.width = cols; low.height = rows;
    const g = low.getContext('2d', { willReadFrequently: true })!; draw(g);
    const d = g.getImageData(0, 0, cols, rows).data;
    canvas.width = cols * cell; canvas.height = rows * cell;
    const c = canvas.getContext('2d')!;
    const sh = (rgb: number[], k: number) => `rgb(${rgb.map(v => Math.max(0, Math.min(255, Math.round(v * k)))).join(',')})`;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const i = (y * cols + x) * 4;
      const rgb = d[i + 3] > 110 ? [d[i], d[i + 1], d[i + 2]] : bg;
      if (!rgb) continue;
      const px = x * cell, py = y * cell, e = Math.max(1, cell * .09), r = cell * .3;
      c.fillStyle = `rgb(${rgb})`; c.fillRect(px, py, cell, cell);
      c.fillStyle = sh(rgb, 1.16); c.fillRect(px, py, cell, e); c.fillRect(px, py, e, cell);
      c.fillStyle = sh(rgb, .62); c.fillRect(px, py + cell - e, cell, e); c.fillRect(px + cell - e, py, e, cell);
      c.fillStyle = sh(rgb, .6); c.beginPath(); c.arc(px + cell / 2 + cell * .05, py + cell / 2 + cell * .06, r, 0, 7); c.fill();
      c.fillStyle = `rgb(${rgb})`; c.beginPath(); c.arc(px + cell / 2, py + cell / 2, r, 0, 7); c.fill();
      c.strokeStyle = sh(rgb, 1.3); c.lineWidth = Math.max(1, cell * .07); c.beginPath(); c.arc(px + cell / 2, py + cell / 2, r * .82, Math.PI * .95, Math.PI * 1.6); c.stroke();
    }
  }
  const bg = [21, 41, 46];
  document.fonts.ready.then(() => brickify(document.getElementById('qs-brick-word') as HTMLCanvasElement, 100, 16, g => {
    g.font = '800 15px system-ui, -apple-system, "Segoe UI", Arial, sans-serif'; g.textBaseline = 'alphabetic';
    const w = g.measureText('querysolo').width, x = Math.round((100 - w) / 2);
    g.fillStyle = '#F0F2E8'; g.fillText('query', x, 12); g.fillStyle = '#D6EE83'; g.fillText('solo', x + g.measureText('query').width, 12);
  }, bg, 12));
</script>
