import Exploration from '../../layouts/Exploration.astro';
import Wordmark from '../../components/exploration/Wordmark.astro';
import Availability from '../../components/exploration/Availability.astro';
import { url } from '../../lib/url';
---
<Exploration title="Product first" active="product" theme="product">
  <header class="site-nav section-frame"><Wordmark /><nav aria-label="Product navigation"><a href="#workflow">How it works</a><a href={url('/docs')}>Documentation</a><a class="button small" href={url('/docs/install')}>Try QuerySolo <span>↗</span></a></nav></header>
  <main id="main">
    <section class="product-hero section-frame">
      <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Open source · Developer preview</p><h1>Your next answer.<br /><em>Closer than<br class="desktop-break" /> you think.</em></h1><p class="lede">Turn your files into queryable tables. See what a query will take. Get an answer on the laptop you already have.</p><div class="hero-actions"><a class="button" href={url('/docs/install')}>Start with your data <span>↗</span></a><a class="text-link" href="#workflow">Take a closer look ↓</a></div><p class="small-note">Free locally · macOS & Linux · Install from source</p></div>
      <div class="product-object" aria-label="A file becoming a queryable Iceberg table"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="object-label top">A FAMILIAR START</span><div class="file-object"><span class="file-type">CSV</span><i></i><i></i><i></i><strong>orders.csv</strong><small>Your data, at home.</small></div><div class="floating-verdict"><span class="status-dot"></span><div><strong>Runs here</strong><small>A little clarity before you query.</small></div><span>↗</span></div><span class="object-label bottom">AN OPEN FORMAT UNDERNEATH</span><div class="format-chips"><span>Parquet</span><span>Apache Iceberg</span></div></div>
    </section>
    <section class="product-showcase section-frame" aria-labelledby="showcase-title"><div class="section-heading"><div><p class="eyebrow">A workspace for the question at hand</p><h2 id="showcase-title">From “what’s in here?”<br />to “there it is.”</h2></div><p>Tables, SQL, a verdict, and a chart.<br />Together in one local workspace.</p></div><figure class="app-figure"><div class="window-title"><span><i></i><i></i><i></i></span><span>Lakeside demo / QuerySolo</span><span>LOCAL</span></div><img src={url('/screenshots/workspace.png')} width="1440" height="900" alt="The QuerySolo application querying generated shop orders, with the table explorer, a Runs here verdict, a regional revenue chart, and a results table." loading="eager" /><figcaption>Actual application UI in the browser test harness · generated sample data · September 2026</figcaption></figure></section>
    <section id="workflow" class="workflow section-frame"><div class="section-heading"><div><p class="eyebrow">Small steps. Useful answers.</p><h2>A familiar way to work.</h2></div><a class="text-link" href={url('/docs/install')}>Follow the quickstart ↗</a></div><div class="workflow-grid"><article><span class="step-number">01</span><h3>Bring a file.</h3><p>Import a CSV, Parquet, JSON, or Excel file. Preview its columns before creating an Iceberg table.</p><code>querysolo import orders.csv</code></article><article><span class="step-number">02</span><h3>See what it takes.</h3><p>The gauge estimates the scan, memory, and time. A short sentence helps you decide what to run.</p><div class="inline-verdict"><span class="status-dot"></span> Runs here <span>· estimate first</span></div></article><article><span class="step-number">03</span><h3>Keep a good question.</h3><p>Save useful SQL as a dbt model with checks and a version. Come back to it when the next file arrives.</p><code>models/questions/revenue.sql</code></article></div></section>
    <section class="ownership section-frame"><span class="ownership-symbol" aria-hidden="true">↗</span><div><p class="eyebrow">Yours to build on</p><h2>Your files.<br />An open way forward.</h2><p>Parquet data. Iceberg tables. A REST catalog other engines can read. The local core is open source under Apache 2.0.</p><a class="text-link" href={url('/docs/catalog')}>Look under the surface ↗</a></div></section>
    <Availability />
    <section class="closing section-frame"><p class="eyebrow">Start small</p><h2>Bring one question.</h2><a class="button" href={url('/docs/install')}>Try the developer preview ↗</a></section>
  </main>
</Exploration>
