---
// Copyright 2026 Lakelet contributors
// SPDX-License-Identifier: Apache-2.0
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import NextStep from '../components/NextStep.astro';
import { url } from '../lib/url';
import { plans } from '../data/pricing';
import Waitlist from '../components/Waitlist.astro';
const local = plans.find(p => p.id === 'local')!;
const team = plans.find(p => p.id === 'team')!;
const burst = plans.find(p => p.id === 'burst')!;
---
<Base title="Pricing" description="Lakelet is free and open source for local use. Team and cloud bursting are planned; view the proposed pricing and current availability.">
  <PageIntro label="05 / Pricing" title="Start on your machine." accent="Start for free." description="The local core and desktop app are open source under Apache 2.0. Team services and cloud compute are planned products, not available subscriptions."><a class="button" href={url('/docs/install')}>Get started from source ↗</a><a class="text-link" href="#plans">See the plans ↓</a></PageIntro>
  <section id="plans" class="section-frame pricing-grid"><article class="price-card available"><p class="eyebrow"><span class="status-dot"></span>Available / Developer preview</p><h2>For one</h2><div class="price">{local.price}</div><p>Open source. On your machine.</p><ul><li>Desktop app and CLI</li><li>SQL, query gauge, and run history</li><li>Iceberg tables and a local REST catalog</li><li>Saved questions, dbt runs, and versions</li><li>No Lakelet account required</li></ul><a class="button" href={url('/docs/install')}>Try Lakelet ↗</a><small>Source installation · macOS and Linux</small></article><article class="price-card"><p class="eyebrow"><span class="status-dot planned"></span>Planned / Not available yet</p><h2>For a team</h2><div class="price">{team.price}<small>{team.unit}</small></div><p>Proposed pricing for a shared catalog.</p><ul><li>Shared catalog metadata</li><li>Scoped credentials</li><li>Scheduled model runs</li><li>Freshness and test alerts</li></ul><a class="text-link" href="#updates">Follow development ↓</a><small>Planned features and pricing; no subscription to buy today.</small></article><article class="price-card"><p class="eyebrow"><span class="status-dot planned"></span>Planned / Not available yet</p><h2>Burst</h2><div class="price compact">{burst.price}</div><p>Proposed pricing for bigger runs.</p><ul><li>Worker sized to the estimated work</li><li>Maximum cost shown before execution</li><li>Compute billed per run</li><li>No idle worker between runs</li></ul><a class="text-link" href="#updates">Follow development ↓</a><small>The worker and enforced cap are planned, not a current service.</small></article></section>
  <section class="split-section section-frame" id="faq"><div><p class="eyebrow">A few practical answers</p><h2>Know what<br />you’re starting.</h2></div><div class="web-accordions"><details open><summary>Do I need an account or a card? <span>+</span></summary><p>No Lakelet account or card is required for local use. Clone the repository and install from source.</p></details><details><summary>Does free mean no costs at all? <span>+</span></summary><p>Lakelet charges no fee for local open-source use. Your own hardware, storage, and any cloud storage or network charges remain yours.</p></details><details><summary>Can I buy Team or run a cloud burst? <span>+</span></summary><p>Not yet. Both are planned. The prices above describe the proposed offering, not a service you can purchase today.</p></details><details><summary>Is there an installer? <span>+</span></summary><p>Not yet. Signed installers and a brew tap are planned. The installation guide covers the current source workflow.</p><a href={url('/docs/install')}>Installation guide ↗</a></details><details><summary>What if I outgrow my laptop? <span>+</span></summary><p>You can inspect the query, reduce the work, and access the same open tables through another compatible engine. Automatic cloud bursting is planned.</p><a href={url('/docs/catalog')}>Read about the catalog ↗</a></details></div></section>
  <section class="updates-section section-frame" id="updates"><p class="eyebrow">Follow the next chapter</p><h2>Small steps.<br /><span class="accent">Built in the open.</span></h2><p>Follow progress on installers, Team, and cloud workers.</p><Waitlist note="Release and early-access updates. Your email is sent to the signup provider." /></section><NextStep />
</Base>
