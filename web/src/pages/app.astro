import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import NextStep from '../components/NextStep.astro';
import { url } from '../lib/url';
import AppCapture from '../components/AppCapture.astro';
import CurrentState from '../components/CurrentState.astro';
---
<Base title="The app" description="Explore the Lakelet desktop app: import files, write SQL, inspect a query verdict, chart results, and keep useful questions as models.">
  <PageIntro label="01 / The desktop app" title="The question is yours." accent="The workspace is here." description="A local workspace for tables, SQL, and the answers worth keeping. One Python core underneath the desktop app and command line."><a class="button" href={url('/docs/app')}>Run the app from source ↗</a><span class="small-note">Developer preview · macOS + Linux · No installer yet</span></PageIntro>
  <section class="section-frame showcase"><AppCapture /></section>
  <section class="web-section section-frame"><div class="section-heading"><div><p class="eyebrow">One question, end to end</p><h2>Less setup.<br /><span class="accent">More looking at the data.</span></h2></div><p>The app brings the core’s tools together.<br />The same actions are available in the CLI.</p></div><div class="step-list"><article><span>01</span><div><h3>Start with a file.</h3><p>Drop a file or choose a folder. Preview the schema and type conversions before importing. Inspect columns, snapshots, and table details. Read and write tables in S3, or publish a local table to your bucket.</p></div><a href={url('/docs/tables')}>Tables ↗</a></article><article><span>02</span><div><h3>Ask it in SQL.</h3><p>Write a query, check Lookahead’s estimate, and see results stream into a grid. An automatic chart helps you read the shape of the answer. Cancel a query with Esc.</p></div><a href={url('/docs/app')}>Querying ↗</a></article><article><span>03</span><div><h3>Make it repeatable.</h3><p>Save a question as a dbt model. Inspect its SQL and checks, browse its versions, and follow dependencies in Lineage. Run only what changed; the Changes screen shows snapshots, versions, and the latest runs.</p></div><a href={url('/docs/questions')}>Questions ↗</a></article><article><span>04</span><div><h3>Look back at the run.</h3><p>The Gauge screen compares estimates with actuals. Your run history stays in the project, so you can inspect how the estimate behaved.</p></div><a href={url('/docs/gauge')}>The record ↗</a></article></div></section>
  <section class="web-section section-frame"><div class="section-heading"><div><p class="eyebrow">The five screens</p><h2>One window.<br /><span class="accent">Five ways to look.</span></h2></div><p>Tables is the workspace above. The other four, on the same generated sample data.</p></div><div class="screen-gallery">
    <figure><a href={url('/screenshots/questions.png')}><img src={url('/screenshots/questions.png')} width="1440" height="720" loading="lazy" alt="The Questions screen in Simple mode: three saved questions, each with See the answer, Refresh and History." /></a><figcaption>Questions (Technical: Models) · a saved question is a dbt model; <strong>See the answer</strong> opens the workspace with its rows.</figcaption></figure>
    <figure><a href={url('/screenshots/lineage.png')}><img src={url('/screenshots/lineage.png')} width="1440" height="720" loading="lazy" alt="The Lineage screen: four imported tables on the left feeding three fresh models on the right." /></a><figcaption>Lineage (Simple: Map) · what each model reads, coloured by whether it is out of date.</figcaption></figure>
    <figure><a href={url('/screenshots/changes.png')}><img src={url('/screenshots/changes.png')} width="1440" height="900" loading="lazy" alt="The Changes screen: runs, snapshots and saved versions in one list, newest first." /></a><figcaption>Changes (Simple: Recent) · runs, table snapshots and question versions, one list.</figcaption></figure>
    <figure><a href={url('/screenshots/gauge.png')}><img src={url('/screenshots/gauge.png')} width="1440" height="900" loading="lazy" alt="The Gauge screen: runs recorded, a scatter of estimated against actual seconds, and the run log." /></a><figcaption>Gauge · every run's estimate against what it took, on this machine.</figcaption></figure>
  </div></section>
  <section class="split-section section-frame"><div><p class="eyebrow">Built for working at your desk</p><h2>Your pace.<br />Your preferences.</h2><p>Use Simple or Technical language, follow the system appearance or choose a light or dark theme, and keep multiple project windows open.</p></div><div class="key-list"><div><span>Open the command palette</span><kbd>⌘ / Ctrl K</kbd></div><div><span>Open settings</span><kbd>⌘ / Ctrl ,</kbd></div><div><span>Cancel a running query</span><kbd>Esc</kbd></div><p>See the <a href={url('/docs/app')}>app guide</a> for the full keyboard reference and source-build requirements.</p></div></section>
  <CurrentState /><NextStep title="Bring a file. Follow a question." />
</Base>
