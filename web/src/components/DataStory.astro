import { overture, demoQueries, secondsAt, verdictFor, verdictWords } from '../data/demo';
import { url } from '../lib/url';
const seconds = secondsAt(demoQueries[0].scanMb, overture.laptopMbps);
---
    <section id="experiment" class="experiment section-frame" aria-labelledby="experiment-title">
      <div class="experiment-top"><div><p class="eyebrow">01 / Your query gauge</p><h2 id="experiment-title">Meet Lookahead.</h2></div><span class="dataset-tag">OVERTURE ADDRESSES · {overture.addresses.files} FILES</span></div>
      <fieldset class="query-choice"><legend>Choose what to read</legend><label><input type="radio" name="scan" value="grouped" checked /><span><b>Count by country</b><small>Read one column</small></span><i>01</i></label><label><input type="radio" name="scan" value="everything" /><span><b>Read everything</b><small>Read every column</small></span><i>02</i></label></fieldset>
      <div class="experiment-body"><div class="scan-visual"><div class="scan-heading"><span>TABLE SIZE <b>21.9 GB</b></span><span>SHARE TO READ <b id="scan-share">1%</b></span></div><div class="scan-blocks" aria-hidden="true">{Array.from({ length: 100 }, (_, i) => <i class={i === 0 ? 'active' : ''}></i>)}</div><div class="scan-legend"><span><i></i> Data to read</span><span><i></i> Data left in the bucket</span></div><div class="sql-strip"><span>SQL</span><code id="story-sql">{demoQueries[0].sql}</code></div></div><div class="experiment-readout"><p class="eyebrow">DATA TO READ</p><div class="readout-number"><span id="scan-number">218.9</span> <small id="scan-unit">MB</small></div><p class="readout-explanation" id="scan-explanation">One column from a 21.9 GB table.</p><div class="bandwidth-control"><label for="bandwidth">Your connection <output id="bandwidth-value" for="bandwidth">111 Mbps</output></label><input id="bandwidth" type="range" min="10" max="1000" value="111" step="1" /><div><span>10 Mbps</span><span>1 Gbps</span></div></div><div class="transfer-result" data-verdict={verdictFor(seconds)}><span>Estimated transfer time</span><output id="transfer-time" for="bandwidth">{Math.round(seconds)}<small> seconds</small></output><p aria-live="polite" aria-atomic="true" id="transfer-verdict"><span class="status-dot"></span>{verdictWords[verdictFor(seconds)]}</p></div></div></div>
      <p class="experiment-note">Illustration of transfer time only: scan size ÷ connection speed. Colors use Lookahead’s time thresholds. The full query gauge also estimates CPU, memory, and spill. This is not a live query or a benchmark of your machine. <a href={url('/docs/gauge')}>How the full estimate works ↗</a></p>
      <noscript><p class="experiment-note">The default example is shown. Enable JavaScript to compare queries and connection speeds.</p></noscript>
    </section>
  <script>
    import { demoQueries, secondsAt, verdictFor, verdictWords } from '../data/demo';
    const bandwidth = document.querySelector<HTMLInputElement>('#bandwidth')!;
    const choices = document.querySelectorAll<HTMLInputElement>('input[name="scan"]');
    const setText = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
    const update = () => {
      const id = document.querySelector<HTMLInputElement>('input[name="scan"]:checked')!.value;
      const query = demoQueries.find(q => q.id === id)!;
      const full = query.id === 'everything';
      const speed = Number(bandwidth.value);
      const seconds = secondsAt(query.scanMb, speed);
      const verdict = verdictFor(seconds);
      setText('story-sql', query.sql);
      setText('scan-number', full ? '21.9' : '218.9');
      setText('scan-unit', full ? 'GB' : 'MB');
      setText('scan-share', full ? '100%' : '1%');
      setText('scan-explanation', full ? 'Every column of every file in the table.' : 'One column from a 21.9 GB table.');
      setText('bandwidth-value', `${speed.toLocaleString('en-US')} Mbps`);
      setText('transfer-time', seconds < 60 ? `${Math.round(seconds)} seconds` : `${(seconds / 60).toFixed(1)} minutes`);
      setText('transfer-verdict', verdictWords[verdict]);
      document.querySelector<HTMLElement>('.transfer-result')!.dataset.verdict = verdict;
      document.querySelectorAll('.scan-blocks i').forEach((block, i) => block.classList.toggle('active', full || i === 0));
    };
    bandwidth.addEventListener('input', update);
    choices.forEach(choice => choice.addEventListener('change', update));
  </script>
