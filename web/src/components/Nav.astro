import Brand from './Brand.astro';
import { nav, site } from '../data/nav';
import { url, isCurrent } from '../lib/url';
const current = (href: string) => isCurrent(href, Astro.url.pathname) || (href === '/docs' && Astro.url.pathname.includes('/docs/'));
---
<header class="web-header section-frame">
  <Brand />
  <nav class="desktop-nav" aria-label="Main navigation">{nav.map(item => <a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <a class="button small header-cta" href={url(site.cta.href)}>{site.cta.label} <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{nav.map(item => <a href={url(item.href)} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}<a href={site.github}>GitHub ↗</a></nav></details>
</header>
