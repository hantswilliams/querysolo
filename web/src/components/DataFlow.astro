import { url } from '../lib/url';
---
<section id="data-flow" class="web-section section-frame" aria-labelledby="data-flow-title">
  <div class="section-heading">
    <div><p class="eyebrow">03 / Nothing leaves. Any engine reads.</p><h2 id="data-flow-title">Your machine. Your bucket.<br /><span class="accent">Your tables.</span></h2></div>
    <p>Work locally. Read and write tables in S3.<br />Remote compute on the same tables is planned.</p>
  </div>
  <figure class="data-flow" aria-labelledby="data-flow-title" aria-describedby="data-flow-caption">
    <div class="flow-legend"><span><i></i>Available today</span><span><i class="planned"></i>Planned paths</span></div>
    <div class="flow-grid">
      <div class="flow-node laptop-node">
        <p class="node-label">ON YOUR MACHINE</p>
        <svg class="flow-icon" width="144" height="96" viewBox="0 0 144 96" fill="none" aria-hidden="true"><rect x="24" y="10" width="96" height="64" rx="5" stroke="currentColor" stroke-width="2"/><path d="M24 75 10 85h124l-14-10M50 85h44" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M44 40c10-12 18-12 28 0s18 12 28 0M44 52c10-12 18-12 28 0s18 12 28 0" stroke="currentColor" stroke-width="2"/></svg>
        <h3>Your laptop</h3>
        <p>DuckDB + dbt Core<br />QuerySolo app + CLI</p>
        <span class="node-foot">Local Parquet + Iceberg</span>
      </div>
      <div class="data-connection laptop-connection" aria-label="Read S3 data on your laptop and publish local tables to S3 today.">
        <div><span>Read data</span><span class="flow-arrow" aria-hidden="true">←</span><small>Available today</small></div>
        <div><span>Publish tables</span><span class="flow-arrow" aria-hidden="true">→</span><small>Available today</small></div>
      </div>
      <div class="flow-node bucket-node">
        <p class="node-label">IN YOUR CLOUD ACCOUNT</p>
        <svg class="flow-icon" width="144" height="96" viewBox="0 0 144 96" fill="none" aria-hidden="true"><ellipse cx="72" cy="19" rx="48" ry="12" fill="currentColor" fill-opacity=".1" stroke="currentColor" stroke-width="2"/><path d="M24 19v57c0 7 22 13 48 13s48-6 48-13V19M24 49c0 7 22 13 48 13s48-6 48-13" stroke="currentColor" stroke-width="2"/><path d="m57 45 10 7 19-14" stroke="currentColor" stroke-width="2"/></svg>
        <h3>Your S3 bucket</h3>
        <p>Read existing Parquet in place.<br />Write Iceberg tables here, too.</p>
        <span class="node-foot">s3://your-bucket/</span>
      </div>
      <div class="data-connection worker-connection future-path" aria-label="Planned remote compute reads and writes the same Iceberg tables in your bucket."><div><span>Read / write</span><span class="flow-arrow" aria-hidden="true">↔</span><small>Same prefix, same files<br />Planned</small></div></div>
      <div class="flow-node worker-node">
        <p class="node-label"><span class="future-tag">PLANNED</span> OFFLOADED JOBS</p>
        <svg class="flow-icon" width="144" height="96" viewBox="0 0 144 96" fill="none" aria-hidden="true"><rect x="40" y="17" width="64" height="64" rx="5" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4"/><rect x="53" y="30" width="38" height="38" rx="3" stroke="currentColor" stroke-width="2"/><path d="M55 7v10M72 7v10M89 7v10M55 81v10M72 81v10M89 81v10M30 32h10M30 49h10M30 66h10M104 32h10M104 49h10M104 66h10" stroke="currentColor" stroke-width="2"/></svg>
        <h3>Remote compute</h3>
        <p>Run a job near your data.<br />Use the same Iceberg tables.</p>
        <span class="node-foot">Compute on demand</span>
      </div>
      <div class="flow-catalog"><div><span class="catalog-mark" aria-hidden="true">≡</span><h3>Iceberg REST catalog</h3><span class="catalog-status">LOCAL TODAY</span></div><p>SQLite on your laptop keeps track of the tables and their metadata.</p><small>Shared catalog and remote-job coordination are planned.</small></div>
    </div>
    <figcaption id="data-flow-caption"><strong>Today:</strong> read existing Parquet in S3, write tables into an S3 warehouse, or publish a local table to your bucket with every snapshot kept. Attached tables’ metadata stays on your laptop by default; S3 warehouse tables keep their data and Iceberg metadata in the bucket. The catalog stays local. <strong>Remote compute and a shared catalog are planned.</strong></figcaption>
  </figure>
  <div class="flow-links"><a class="text-link" href="#experiment">See what fits with Lookahead ↓</a><a class="text-link" href={url('/docs/remote')}>Read and write in S3 ↗</a><a class="text-link" href={url('/docs/tables#publishing-a-table-into-a-bucket')}>Publish a local table ↗</a><a class="text-link" href={url('/docs/catalog')}>How the catalog works ↗</a></div>
</section>

<style>
  #data-flow{padding-top:25px}
  .data-flow{border:1px solid var(--line);border-radius:5px;background:#12252a;padding:28px 30px 0;overflow:hidden}
  .flow-legend{display:flex;justify-content:flex-end;gap:25px;font:10px var(--mono);color:var(--muted);margin-bottom:30px}
  .flow-legend>span{display:flex;align-items:center;gap:9px}
  .flow-legend i{display:inline-block;width:25px;border-top:2px solid var(--accent)}
  .flow-legend i.planned{border-top:2px dashed #9babac}
  .flow-grid{display:grid;grid-template-columns:minmax(0,1fr) 120px minmax(0,1fr) 120px minmax(0,1fr);align-items:center;gap:0}
  .flow-node{min-width:0;text-align:center;border:1px solid #3f5a58;background:#172d30;border-radius:5px;padding:22px 12px 25px;align-self:stretch}
  .flow-node .node-label{font:9px/1.8 var(--mono);letter-spacing:.04em;color:var(--muted);min-height:33px}
  .flow-icon{display:block;max-width:100%;color:var(--accent);margin:18px auto 24px}
  .flow-node h3{font-size:23px;font-weight:500;letter-spacing:-.6px;margin:0 0 15px}
  .flow-node>p:not(.node-label){font-size:12px;line-height:1.85;color:var(--muted)}
  .node-foot{display:block;font:9px/1.8 var(--mono);color:var(--muted);border-top:1px solid var(--line);margin-top:22px;padding-top:16px}
  .bucket-node{background:#23392f;border-color:#96ae65}
  .bucket-node h3{color:var(--accent)}
  .worker-node{border-style:dashed;border-color:#7a9191;background:#14272c}
  .worker-node .flow-icon{color:#9eafae}
  .future-tag{color:#c6d2cf;border:1px dashed #7a9191;border-radius:3px;padding:3px 5px;font-size:8px;margin-right:5px}
  .data-connection{text-align:center;color:var(--accent);padding:0 8px;font-size:11px;line-height:1.6}
  .data-connection>div+div{margin-top:28px}
  .data-connection .flow-arrow{display:block;font:46px/.8 Arial,sans-serif;font-weight:400;margin:10px 0 8px}
  .data-connection small{display:block;font:8px/1.8 var(--mono)}
  .future-path{color:#b0c0bc}
  .flow-catalog{grid-column:1/-1;justify-self:center;margin-top:38px;padding:23px 30px;border:1px solid var(--line);border-radius:4px;background:#102126;text-align:center;position:relative}
  .flow-catalog:before{content:'';position:absolute;left:50%;top:-39px;height:38px;border-left:1px solid #789068}
  .flow-catalog>div{display:flex;align-items:center;justify-content:center;gap:12px}
  .catalog-mark{color:var(--accent);font-size:30px;line-height:1}
  .flow-catalog h3{font-size:17px;font-weight:500;letter-spacing:-.3px}
  .catalog-status{font:8px var(--mono);color:var(--accent);border:1px solid #4c6346;padding:5px 7px;border-radius:2px}
  .flow-catalog p{font-size:12px;color:var(--muted);margin-top:13px}
  .flow-catalog small{display:block;font:9px/1.8 var(--mono);color:var(--muted);margin-top:9px}
  figcaption{border-top:1px solid var(--line);padding:23px 0;margin-top:30px;font-size:12px;line-height:1.9;color:var(--muted)}
  figcaption strong{color:#d7e1d5;font-weight:500}
  .flow-links{display:flex;flex-wrap:wrap;gap:30px;margin-top:27px}
  @media(max-width:1100px){.data-flow{padding:24px 20px 0}.flow-grid{grid-template-columns:minmax(0,1fr) 95px minmax(0,1fr) 95px minmax(0,1fr)}.flow-node h3{font-size:20px}.flow-node .node-label{font-size:8px}.flow-node>p:not(.node-label){font-size:11px}.node-foot{font-size:8px}.data-connection{font-size:10px}.data-connection small{font-size:7px}.future-tag{display:block;width:fit-content;margin:0 auto 5px}.flow-icon{width:120px;height:80px}}
  @media(max-width:800px){.flow-grid{grid-template-columns:minmax(0,1fr);max-width:460px;margin:auto}.flow-legend{justify-content:center;margin-bottom:25px;font-size:10px;gap:20px}.flow-node{padding:25px 20px}.flow-node .node-label{font-size:10px;min-height:0}.flow-node h3{font-size:26px}.flow-node>p:not(.node-label){font-size:14px}.node-foot{font-size:11px}.flow-icon{width:144px;height:96px;margin:20px auto}.future-tag{display:inline;margin-right:7px;font-size:9px}.data-connection{display:flex;justify-content:center;gap:45px;padding:24px 0;font-size:12px}.data-connection>div+div{margin-top:0}.data-connection .flow-arrow{transform:rotate(90deg);font-size:40px;height:40px;margin:8px 0}.data-connection small{font-size:9px}.flow-catalog{padding:23px 18px;width:100%;margin-top:32px}.flow-catalog:before{display:none}.flow-catalog>div{flex-wrap:wrap;gap:10px}.flow-catalog h3{font-size:18px}.catalog-status{font-size:9px}.flow-catalog p{font-size:13px}.flow-catalog small{font-size:10px}.flow-links{flex-wrap:wrap;gap:20px}figcaption{font-size:12px}}
  @media(max-width:400px){.data-flow{padding:22px 17px 0}.flow-legend{font-size:9px;gap:18px}.flow-legend i{width:18px}.flow-node{padding:23px 16px}.data-connection{gap:27px}.flow-node .node-label{font-size:9px}.flow-catalog h3{font-size:16px}.flow-links .text-link{font-size:13px}}
</style>
