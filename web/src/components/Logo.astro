---
// Copyright 2026 QuerySolo contributors
// SPDX-License-Identifier: Apache-2.0
// The querysolo lockup: the prompt mark and the wordmark (logo-querysolo-plan.md L2, L3).
// `dark` renders it for dark bands: off-white text and a lime accent.
interface Props { width?: number; dark?: boolean; class?: string }
const { width = 150, dark = false, class: cls = '' } = Astro.props;
const ink = dark ? '#F0F2E8' : '#1A2A26';
const accent = dark ? '#D6EE83' : '#164F44';
---
<svg width={width} height={Math.round(width * 70 / 300)} viewBox="0 0 300 70" role="img" aria-label="querysolo" class={cls}>
  <g transform="translate(4,6) scale(.9)"><path d="M13 19 L27 32 L13 45" fill="none" stroke={ink} stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><rect x="32" y="39" width="20" height="7" rx="2.5" fill={accent}/></g>
  <text x="62" y="50" font-family="Manrope,system-ui,sans-serif" font-weight="800" font-size="38" letter-spacing="-0.9" fill={ink}>query<tspan fill={accent}>solo</tspan></text>
</svg>
