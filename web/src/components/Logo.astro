---
// The querysolo wordmark with the leaping fish. `dark` renders white text (for dark bands).
interface Props { width?: number; dark?: boolean; class?: string }
const { width = 150, dark = false, class: cls = '' } = Astro.props;
const fill = dark ? '#FFFFFF' : '#172029';
---
<svg width={width} height={Math.round(width * 70 / 300)} viewBox="0 0 300 70" role="img" aria-label="querysolo" class={cls}>
  <text x="12" y="52" font-family="Manrope,system-ui,sans-serif" font-weight="800" font-size="40" letter-spacing="-0.9" fill={fill}>querysolo</text>
  <g transform="translate(76,14) rotate(-18) scale(.6)"><path d="M-12 0 L-22 -8 C-19 -3, -19 3, -22 8 Z" fill="#E8731A"/><ellipse rx="14" ry="9" fill="#F5A623"/><path d="M-3 -8 C0 -14, 6 -13, 7 -7 Z" fill="#E8731A"/><circle cx="7" cy="-2" r="3" fill="#fff"/><circle cx="8" cy="-2" r="1.5" fill="#172029"/></g>
</svg>
