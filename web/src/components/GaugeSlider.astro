---
// The hero terminal: a real public dataset attached with no AWS account, and the gauge's
// verdict on two queries over it as you move the one number that differs per visitor --
// your link speed. Scan sizes are measured (src/data/demo.ts, from /docs/remote); the
// time is the gauge's own I/O arithmetic, done in the browser, at the thresholds the
// product actually uses. Nothing here is invented, and none of it needs an account.
import Terminal from './Terminal.astro';
import { overture, demoQueries, fmtRows } from '../data/demo';
const a = overture.addresses;
---
<Terminal
  title={`zsh · ~/querysolo-open · no AWS account · ${overture.laptopMbps} Mbps`}
  class="gauge-slider"
  label="Interactive terminal: a 472-million-row public dataset attached without credentials, with the gauge's verdict on two queries. Drag the slider to change the link speed and watch the verdicts change.">
<pre><span class="p">$</span> querysolo tables attach addresses --anonymous \
    <span class="o">{a.prefix}</span>
  <span class="g">✓</span> {fmtRows(a.rows)} rows · {a.files} files · {a.gb} GB <span class="d">· nothing copied</span>
  <span class="d">public bucket · no credentials · metadata written to ./warehouse</span>

<span class="p">$</span> querysolo estimate <span class="o">"{demoQueries[0].sql}"</span>
  <span id="q0dot" class="g">●</span> <span id="q0verdict" class="w">Runs here</span> <span id="q0detail" class="d">· scans 218.9 MB of 21.9 GB · ~16 s at your 111 Mbps</span>

<span class="p">$</span> querysolo estimate <span class="o">"{demoQueries[1].sql}"</span>
  <span id="q1dot" class="r">●</span> <span id="q1verdict" class="w">Needs more machine</span> <span id="q1detail" class="d">· scans 21.9 GB · ~26 min at your 111 Mbps</span></pre>
  <div class="ctlrow"><span>your downlink</span><output id="mbpsOut">{overture.laptopMbps} Mbps · measured</output></div>
  <input type="range" id="mbps" min="5" max="400" value={overture.laptopMbps} step="1" aria-label="Your downlink speed in megabits per second">
</Terminal>

<script>
  import { demoQueries, overture, secondsAt, verdictFor, verdictWords } from '../data/demo';

  const slider = document.getElementById('mbps') as HTMLInputElement | null;
  const out = document.getElementById('mbpsOut');
  if (slider && out) {
    const cls = { green: 'g', yellow: 'y', red: 'r' } as const;
    const fmt = (sec: number) =>
      sec < 90 ? Math.round(sec) + ' s'
      : sec < 5400 ? Math.round(sec / 60) + ' min'
      : (sec / 3600).toFixed(1) + ' h';
    const mb = (n: number) => (n >= 1000 ? (n / 1000).toFixed(1) + ' GB' : n.toFixed(1) + ' MB');

    const rows = demoQueries.map((q, i) => ({
      q,
      dot: document.getElementById(`q${i}dot`),
      verdict: document.getElementById(`q${i}verdict`),
      detail: document.getElementById(`q${i}detail`),
    }));

    const update = () => {
      const mbps = +slider.value;
      out.textContent = mbps + ' Mbps' + (mbps === overture.laptopMbps ? ' · measured' : '');
      for (const r of rows) {
        if (!r.dot || !r.verdict || !r.detail) continue;
        const sec = secondsAt(r.q.scanMb, mbps);
        const v = verdictFor(sec);
        r.dot.className = cls[v];
        r.verdict.textContent = verdictWords[v];
        r.detail.textContent =
          `· scans ${mb(r.q.scanMb)}${r.q.scanMb < 1000 ? ' of ' + r.q.of : ''} · ~${fmt(sec)} at your ${mbps} Mbps`;
      }
    };
    slider.addEventListener('input', update);
    update();
  }
</script>

<style>
  .ctlrow{display:flex;justify-content:space-between;align-items:center;padding:6px 16px 4px;font-size:12px;color:#9AA8B6}
  .ctlrow output{font-family:var(--mono);color:#C9D2DC}
  :global(.gauge-slider) input[type=range]{width:calc(100% - 32px);margin:0 16px 14px;accent-color:#F5A623}
</style>
